<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="/style.css">
    <title>Home</title>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    
    <!-- Logo -->
    <a class="navbar-brand fw-bold">CampusSync</a>

    <!-- Toggle button (mobile) -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Links -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">


        <li class="nav-item">
          <a class="nav-link active" href="/discussion">Discussion</a>
        </li>

        <li class="nav-item">
          <a class="nav-link text-warning fw-bold" href="/marketplace">Buy Item</a>
        </li>

      <li class="nav-item">
  <a class="nav-link text-primary fw-bold" href="/profile">Profile</a>
</li>
         <li class="nav-item">
          <a class="btn btn-outline-danger ms-lg-3 mt-2 mt-lg-0" href="/logout">Logout</a>
        </li>

      </ul>
    </div>

  </div>
</nav>
<h2 class="m-3 text-center">Let's be  Updated!</h2>
<div class="d-flex flex-wrap gap-2 mb-4 justify-content-center">
<a href="/discussion" class="btn btn-sm rounded-pill px-3 btn-secondary">All (<%= counts.all %>)</a>
<a href="/discussion?category=internship" class="btn btn-sm rounded-pill px-3 btn-success">Internship (<%= counts.internship %>)</a>
<a href="/discussion?category=events" class="btn btn-sm rounded-pill px-3 btn-warning">Events (<%= counts.events %>)</a>
<a href="/discussion?category=general" class="btn btn-sm rounded-pill px-3 btn-primary">General (<%= counts.general %>)</a>
</div>
<% if(posts.length === 0) { %>
  <div class="text-center mt-5">
    <p class="fs-5" style="color: #150115;">No posts yet. Be the first to post! 🎉</p>
     <a href="/create" class="btn btn-outline-primary btn-sm w-45">Create Post</a>
  </div>
<% } %>
<% posts.forEach(post => { %>

  <div class="card shadow-sm mb-3 p-3 rounded-3 mx-auto w-100" style="max-width: 800px;">
    
    <!-- 👤 Username + Category -->
    <div class="d-flex justify-content-between align-items-center mb-2">
      
      <h6 class="mb-0 fw-semibold">@<%= post.user.username %></h6>

      <span class="badge 
        <%= post.category === 'internship' ? 'bg-success' : 
            post.category === 'events' ? 'bg-warning text-dark' : 
            'bg-primary' %>">
        <%= post.category %>
      </span>

    </div>

   
  
<p class="mb-1 post-text" data-full="<%= post.content %>" data-short="<%= post.content.substring(0, 150) %>">
  <%= post.content.length > 150 ? post.content.substring(0, 150) + '...' : post.content %>
  <% if(post.content.length > 150){ %><a href="#" class="read-more text-primary" style="font-size:0.85rem;"> Read more</a><% } %>
</p>
   
    <div class="d-flex align-items-center gap-2 mt-2">
  <small><%= post.likes.length %> likes</small>
  <button onclick="handleLike(this, '<%= post._id %>')" class="btn btn-primary btn-sm rounded-pill">
    <%= user && user.userid && post.likes.some(id => id.toString() === user.userid.toString()) ? "Unlike" : "Like" %>
  </button>
  <button class="btn btn-outline-secondary btn-sm rounded-pill" onclick="toggleComments('<%= post._id %>')">
    💬 Comments (<%= comments.filter(c => c.post.toString() === post._id.toString()).length %>)
  </button>
</div>

<!-- Comments Section (hidden by default) -->
<div class="mt-3" id="comments-<%= post._id %>" style="display:none;">
  <% comments.filter(c => c.post.toString() === post._id.toString()).forEach(comment => { %>
    <div class="d-flex justify-content-between align-items-center bg-light rounded p-2 mb-1">
      <div>
        <small class="fw-bold">@<%= comment.user ? comment.user.username : 'unknown' %></small>
        <small class="ms-2"><%= comment.content %></small>
      </div>
      <% if(user && comment.user && comment.user._id.toString() === user.userid.toString()) { %>
        <a href="/deletecomment/<%= comment._id %>" class="text-danger ms-2" style="font-size:0.75rem;">✕</a>
      <% } %>
    </div>
  <% }) %>
  <form action="/comment/<%= post._id %>" method="POST" class="d-flex gap-2 mt-2">
    <input type="text" name="content" class="form-control form-control-sm rounded-pill" placeholder="Add a comment..." required>
    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">Post</button>
  </form>
</div>

  </div>

  </div>

<% }) %>

 
 <script>
  async function handleLike(btn, postId) {
    const data = await fetch(`/like/${postId}`).then(r => r.json());
    btn.textContent = data.liked ? "Unlike" : "Like";
    btn.previousElementSibling.textContent = data.likesCount + " likes";
  }

  function toggleComments(postId) {
    const section = document.getElementById('comments-' + postId);
    section.style.display = section.style.display === 'none' ? 'block' : 'none';
  }

  document.querySelectorAll('.read-more').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const p = this.parentElement;
      const isFull = this.textContent.trim() === 'Read less';
      p.childNodes[0].textContent = isFull ? p.dataset.short + '...' : p.dataset.full + ' ';
      this.textContent = isFull ? ' Read more' : ' Read less';
    });
  });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>