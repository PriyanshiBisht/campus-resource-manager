<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>Document</title>
</head>
<body style="  background-color: rgb(223, 214, 231);  font-family: 'Poppins', sans-serif;">
     <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    
    <!-- Logo -->
    <a class="navbar-brand fw-bold">CampusSync</a>

    <!-- Toggle button (mobile) -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Links -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">


        <li class="nav-item">
          <a class="nav-link active" href="/discussion">Discussion</a>
        </li>

        <li class="nav-item">
          <a class="nav-link text-warning fw-bold" href="/marketplace">Buy Item</a>
        </li>

     <li class="nav-item">
  <a class="nav-link text-primary fw-bold" href="/profile">Profile</a>
</li>
         <li class="nav-item">
          <a class="btn btn-outline-danger ms-lg-3 mt-2 mt-lg-0" href="/logout">Logout</a>
        </li>

      </ul>
    </div>

  </div>
</nav>
    <div class="container mt-4">

 
   <h2 class="mb-4 text-center">🛒 Find exactly what you need for Class</h2>
<p class="mb-4 text-center"   >The community-driven marketplace for students to buy and sell textbooks,electronics and study materials at affordable prices</p>
<form method="GET" action="/marketplace" class="d-flex justify-content-center mb-4">
  <input type="text" name="search" value="<%= search %>" placeholder="Search items..." class="form-control w-50 px-3 me-2">
  <button type="submit" class="btn btn-dark  px-4">Search</button>
</form>
  <div class="row g-4">
<% if(items.length === 0) { %>
  <div class="text-center mt-5">
    <p class="text-muted fs-5">No items found. Try a different search! 🔍</p>
  </div>
<% } %>
    <% items.forEach(item => { %>

      <div class="col-md-4 col-sm-6">

        <div class="card h-100 shadow-sm border-0">
<p class="fw-bold">Posted by @<%= item.user ? item.user.username : 'unknown' %></p>
          <!-- Image -->
        <img src="<%= item.image %>" 
     class="card-img-top"
     style="height: 200px; object-fit: contain; background-color: #f8f8f8;">

          <!-- Content -->
          <div class="card-body d-flex flex-column">

            <h6 class="fw-bold"><%= item.title %></h6>


            <p class="text-muted small mb-2">
              <%= item.description.substring(0, 60) %>...
            </p>

    <p class="fw-bold">₹ <%= item.price %></p>
            <small class="text-muted mb-2">
              📞 <%= item.contact %>
            </small>

            <!-- Button -->
          <a href="mailto:<%= item.email %>?subject=Interested in your item&body=Hi, I saw your listing on CampusSync."
   class="btn btn-primary btn-sm mt-auto">
   Contact Seller
</a>
<% if (item.user && item.user._id.toString() === user._id.toString()) { %>
  
  <a href="/deleteitem/<%= item._id %>" class="btn btn-danger btn-sm mt-2" onclick="return confirm('Mark this item as sold and remove it?')">Mark as Sold 🗑️</a>
<% } %>

          </div>

        </div>

      </div>

    <% }) %>

  </div>

</div>
<script>
  document.querySelector('input[name="search"]').addEventListener('input', function() {
    if (this.value === '') window.location.href = '/marketplace';
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>