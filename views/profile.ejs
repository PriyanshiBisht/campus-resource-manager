<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="/style.css">
    <title>Home</title>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    
    <!-- Logo -->
    <a class="navbar-brand fw-bold">CampusSync</a>

    <!-- Toggle button (mobile) -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Links -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">


        <li class="nav-item">
          <a class="nav-link active" href="/discussion">Discussion</a>
        </li>

        <li class="nav-item">
          <a class="nav-link text-warning fw-bold" href="/marketplace">Buy Item</a>
        </li>

      <li class="nav-item">
  <a class="nav-link text-primary fw-bold" href="/profile">Profile</a>
</li>
         <li class="nav-item">
         
          <a class="btn btn-outline-danger ms-lg-3 mt-2 mt-lg-0" href="/logout">Logout</a>
        </li>

      </ul>
    </div>

  </div>
</nav>
<div class="container-fluid mt-4 px-4">
  <div class="row">

    <!-- LEFT SIDE - Profile Card -->
    <div class="col-12 col-md-3">
      <div class="card shadow-sm p-4 text-center mb-3" style="border: 2px solid rgb(180, 160, 200);">
        <div style="font-size: 4rem;">👤</div>
        <h4 class="fw-bold mt-2"><%= user.username %></h4>
        <p class="text-muted small mb-1"><%= user.email %></p>
        <hr>
        <p class="mb-1 small"><strong>Posts:</strong> <%= myPosts.length %></p>
        <p class="mb-3 small"><strong>Joined:</strong> <%= new Date(user._id.getTimestamp()).toDateString() %></p>
        <a href="/sell" class="btn btn-outline-primary btn-sm w-100 mb-2">Sell a Resource</a>
        <a href="/create" class="btn btn-outline-primary btn-sm w-100">Create Post</a>
      </div>
    </div>

    <!-- RIGHT SIDE - Posts -->
    <div class="col-12 col-md-9">
      <h2 class="mb-3">My Posts</h2>

      <% myPosts.forEach(post => { %>
        <div class="card shadow-sm mb-3 p-3 rounded-3 w-100">
          <p class="mb-2"><%= post.content %></p>

          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
            <span class="badge 
              <%= post.category === 'internship' ? 'bg-success' : 
                  post.category === 'events' ? 'bg-warning text-dark' : 
                  'bg-primary' %>">
              <%= post.category %>
            </span>
            <small class="text-muted">
              <%= new Date(post.createdAt).toDateString() %>
            </small>
          </div>

          <div class="d-flex gap-2 mt-2">
            <a href="/edit/<%= post._id %>" class="btn btn-warning btn-sm">Edit ✏️</a>
            <a href="/delete/<%= post._id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this post?')">Delete 🗑️</a>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
      
</body>
</html>