<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
   <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="/style.css">
</head>
<body>
   <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    
    <!-- Logo -->
    <a class="navbar-brand fw-bold">CampusSync</a>

    <!-- Toggle button (mobile) -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Links -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">


        <li class="nav-item">
          <a class="nav-link active" href="/discussion">Discussion</a>
        </li>

        <li class="nav-item">
          <a class="nav-link text-warning fw-bold" href="/marketplace">Buy Item</a>
        </li>

        
<li class="nav-item">
  <a class="nav-link text-primary fw-bold" href="/profile">Profile</a>
</li>
         <li class="nav-item">
          <a class="btn btn-outline-danger ms-lg-3 mt-2 mt-lg-0" href="/logout">Logout</a>
        </li>

      </ul>
    </div>

  </div>
</nav>
   <div class="container">
    <div class="left">
        <h1>Share your<span class="f-style"> Knowledge</span>,<br>with the hub</h1>
        <p>Discussion posts are lifeblood of our Academic Community. Provide a clear headline and detailed context to foster meaningful engagement.</p>
  
      <a class="btn btn-outline-primary mb-3" style="border-radius: 10px;">
        View Community Guidelines
      </a>
   <ul class="mt-4" style="list-style: none; padding-left: 0;">
  <li class="mb-3">✅ Be professional and respectful</li>
  <li class="mb-3">📝 Ensure your title is descriptive</li>
  <li class="mb-3">🔗 Include relevant links if applicable</li>
  <li class="mb-3">🚫 Avoid spam</li>
</ul>
      </div>
    <div class="right">
        <form  action="/create-post" method="post" class="form-box">
            <h2>Create Your Post</h2>
          <textarea name="content" id="postContent" class="form-control" placeholder="What's on your mind?" required></textarea>
<input type="text" id="ideaInput" class="form-control mt-2" placeholder="Rough idea? e.g. ml workshop april 25">
<button type="button" class="btn btn-outline-secondary w-100 mt-2" onclick="generatePost()">✨ Generate with AI</button>
<small id="aiStatus" class="text-muted"></small>
<div class="m-4">
  <select name="category" class="form-select w-100" style="border-radius: 10px;"> <option value="general">General</option> <option value="internship">Internship</option> 
    <option value="events">Events</option> 
  </select>
 <button class=" mt-5 btn btn-primary w-100" type="submit">Post</button>
</div>
     

      
        </form>
    </div>
 </div>
 <script>
  async function generatePost() {
    const idea = document.getElementById('ideaInput').value;
    if (!idea) return alert('Please enter a rough idea first!');
    document.getElementById('aiStatus').textContent = 'Generating...';
    const res = await fetch('/generate-post', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idea })
    });
    const data = await res.json();
    document.getElementById('postContent').value = data.content;
    document.getElementById('aiStatus').textContent = '✅ Done! You can edit it before posting.';
  }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>